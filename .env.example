# Copy this file to ".env" for local builds. NEVER commit your real .env.
# On Cloudflare Pages, set these same values under Settings → Environment variables.

# Your Airtable Personal Access Token (starts with "pat...").
# Create it at airtable.com → profile icon → Developer/Builder hub →
# Personal access tokens. Scope needed: data.records:read. Give it access to your base.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your base ID (starts with "app..."). Find it at airtable.com/api or in the base URL.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# The table name exactly as it appears in Airtable (case-sensitive).
AIRTABLE_TABLE=Tools

# Optional: restrict to a specific view (leave blank to use the whole table).
AIRTABLE_VIEW=
